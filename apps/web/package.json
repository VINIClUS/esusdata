{
  "name": "esusdata-helper-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" scripts",
