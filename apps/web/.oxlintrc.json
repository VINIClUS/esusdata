{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Playwright tests (ADR 0025) are not React: a fixture's `use` and `useBackend` are not
      // hooks, and `async ({}, testInfo)` is the runner's required signature.
      "files": ["tests/**", "playwright.*.config.ts"],
      "rules": { "react/rules-of-hooks": "off", "no-empty-pattern": "off" }
    }
  ]
}
