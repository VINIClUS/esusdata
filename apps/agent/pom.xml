<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>esusdata</groupId>
  <artifactId>esusdata-agent</artifactId>
  <version>0.1.1</version>
  <packaging>jar</packaging>
  <name>Observatório APS — agent</name>
  <description>
    Backend monolítico modular do Observatório APS. Versões fixadas conforme o BOM do
    Spring Boot 4.1.1 (verificado em contracts/ e docs/adr) e a Tech Spec v0.4 §1.3.
  </description>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.4.1</archunit.version>
    <networknt-json-schema.version>3.0.7</networknt-json-schema.version>
    <!-- sqlite-jdbc pinned above the BOM's 3.53.2.1: asserts the WAL-reset floor (>=3.51.3, §1.12.1) -->
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
  </properties>

  <dependencies>
    <!-- Core Spring Boot -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- HTTP surface (§1.10) and authenticated sessions (§1.12.7). Both versions come from the
         Boot 4.1.1 BOM (Spring Security 7.1.1 / Tomcat 11.0.24 — confirmed against the resolved
         spring-boot-dependencies POM, not assumed). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Spring Security's Argon2PasswordEncoder (§1.12.7's mandated algorithm) delegates to
         BouncyCastle's Argon2BytesGenerator at the bytecode level (confirmed via javap on
         spring-security-crypto-7.1.1.jar) — it is not optional at runtime. BouncyCastle is not
         managed by the Boot 4.1.1 BOM, so §1.3's "dependências fora do BOM exigem versão explícita"
         applies: pinned to the current Maven Central release, not a range. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.86</version>
    </dependency>

    <!-- OpenAPI (§1.10.1 "documentar contratos em OpenAPI na implementação"): springdoc's latest
         release (2.8.6) targets Spring Framework 6 / Jakarta EE 10; Boot 4.1.1 is Framework 7 /
         Jakarta EE 11, so it is not binary-compatible. The contract lives hand-written at
         contracts/openapi/observatorio-v1.yaml, checked against the registered routes by
         OpenApiContractTest instead of generated. Revisit once a Framework-7-compatible springdoc
         release exists. -->

    <!-- extraction-store manifest + JSON Lines serialization (§1.9.1). Version tracks the
         Boot 4.1.1 BOM's managed tools.jackson:jackson-databind. DTOs represent dates/instants
         as explicit ISO-8601 strings rather than pulling in a jsr310 module — consistent with
         the spec's own textual-serialization discipline for canonical values (§1.7.1). -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- PEC access: pgJDBC only, no JPA/Hibernate anywhere in this project -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- Own persistence: SQLite -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-nc-sqlite</artifactId>
      <version>12.4.0</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${networknt-json-schema.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <!-- contracts/ is the single source of the published PEC compatibility contract (ADR 0009) -->
      <resource>
        <directory>${project.basedir}/../../contracts/compatibility</directory>
        <targetPath>compatibility</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- -Pweb builds apps/web and ships it in the jar under static/, served by
         esusdata.web.SpaWebConfig. Off by default so everyday `mvn verify` skips the frontend.
         Node is downloaded into target/ and pinned here (§1.12.8), not taken from the machine. The
         bundle talks to the real API: VITE_USE_MOCKS=false (ADR 0015). -->
    <profile>
      <id>web</id>
      <build>
        <resources>
          <resource>
            <directory>${project.basedir}/../web/dist</directory>
            <targetPath>static</targetPath>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <version>2.0.2</version>
            <configuration>
              <workingDirectory>${project.basedir}/../web</workingDirectory>
              <installDirectory>${project.build.directory}</installDirectory>
              <nodeVersion>v24.21.0</nodeVersion>
            </configuration>
            <executions>
              <execution>
                <id>install-node-and-npm</id>
                <goals>
                  <goal>install-node-and-npm</goal>
                </goals>
                <phase>generate-resources</phase>
              </execution>
              <execution>
                <id>npm-ci</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>generate-resources</phase>
                <configuration>
                  <arguments>ci</arguments>
                </configuration>
              </execution>
              <execution>
                <id>npm-run-build</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>generate-resources</phase>
                <configuration>
                  <arguments>run build</arguments>
                  <environmentVariables>
                    <VITE_USE_MOCKS>false</VITE_USE_MOCKS>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
