{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatorio-aps.local/contracts/indicators/release-gates.schema.json",
  "title": "Release-gate registry",
  "description": "Schema for contracts/indicators/release-gates.json (ADR 0032). Records, per pack and rule_version, the two gates decided by automated checks outside the run: A (fonte e vigência) and D (reconciliação). Portões B and C are evaluated on every result by the executor and are not in the file. Nobody signs a gate off: an entry names the automated check that passed it, the date, and its evidence. A rule_version bump voids the entry.",
  "type": "object",
  "required": ["schema_version", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packEntry" }
    }
  },
  "$defs": {
    "packEntry": {
      "type": "object",
      "required": ["pack", "rule_version", "gates", "blocking_gaps_closed"],
      "additionalProperties": false,
      "properties": {
        "pack": { "type": "string", "minLength": 1 },
        "rule_version": {
          "type": "string",
          "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "The compiled rule version this entry was checked against: <pack>@<version>."
        },
        "gates": {
          "type": "object",
          "required": ["A", "D"],
          "additionalProperties": false,
          "properties": {
            "A": { "$ref": "#/$defs/gate" },
            "D": { "$ref": "#/$defs/gate" }
          }
        },
        "blocking_gaps_closed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Ids of the blocking gaps (standing limitations) closed by this version."
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["PENDING", "PASSED", "FAILED"] },
        "check": {
          "type": "string",
          "pattern": "^[a-z0-9-]+@[0-9]+$",
          "description": "The automated check that decided it, e.g. conferencia-fichas@1 or reconciliacao-siaps@1."
        },
        "checked_at": { "type": "string", "format": "date" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASSED" } }, "required": ["status"] },
          "then": {
            "required": ["check", "checked_at", "evidence"],
            "properties": { "evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
          "then": { "required": ["check", "checked_at"] }
        },
        {
          "if": { "properties": { "status": { "const": "PENDING" } }, "required": ["status"] },
          "then": { "not": { "anyOf": [{ "required": ["check"] }, { "required": ["checked_at"] }] } }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "ref", "sha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1, "description": "Repo-relative path of the document." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
