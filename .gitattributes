# Checksummed contract files (frozen query text, compatibility matrix) must be byte-identical on
# every OS: a CRLF checkout on Windows changed the query checksum and failed every live
# acquisition of the Windows package (ADR 0014).
contracts/** text eol=lf

# SQL fixtures outside contracts/ are checksummed too (fixture_checksum, CapabilityMatrixConsistencyTest).
*.sql text eol=lf

# Formatting is checked byte-for-byte (Spotless, rustfmt; ADR 0018), including on the Windows
# package job: sources are LF everywhere.
*.java text eol=lf
*.rs text eol=lf

# Release-gate evidence (contracts/indicators/release-gates.json, ADR 0032) is pinned by the
# sha256 of a document under docs/: a CRLF checkout on Windows changed every hash and failed
# ReleaseGatesConsistencyTest in the Windows package job.
docs/**/*.md text eol=lf

# The reference policy (contracts/indicators/siaps-reference-policy.json) pins the reference
# manifests and the compatibility dossiers under docs/ by sha256, and the Portão D hashes the
# fixtures it replays: a CRLF checkout on Windows would change every hash of that evidence.
docs/**/*.json text eol=lf
apps/agent/src/test/resources/** text eol=lf
